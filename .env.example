# Copy to .env and fill in. Only APP_SECRET is required.

# Encrypts API keys and signs sessions. Generate: openssl rand -base64 32
APP_SECRET=

# Public address of the app (links in Telegram messages, auth cookies).
APP_URL=http://localhost:3000

# Optional: Telegram bot from @BotFather for decisions and run updates.
TELEGRAM_BOT_TOKEN=

# How many novels translate at the same time.
WORKER_CONCURRENCY=2

POSTGRES_PASSWORD=ranobe
PORT=3000

# Only for running outside Docker (pnpm dev):
# DATABASE_URL=postgres://ranobe:ranobe@localhost:5432/ranobe
