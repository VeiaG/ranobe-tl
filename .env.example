# Everything here is optional: compose.yml runs without a .env file.
# Full list with explanations: docs/configuration.md

# Pin a release instead of following the newest one, e.g. 0.2.0
# RANOBE_TL_VERSION=latest

# The address you open the app at, when it has one (a domain behind a proxy).
# Turns on Secure cookies and puts links into Telegram messages.
# APP_URL=https://tl.example.com

# Encrypts API keys and signs sessions. Generated into the /data volume when empty.
# APP_SECRET=

# Telegram bot from @BotFather (can also be set in Settings → Telegram).
# TELEGRAM_BOT_TOKEN=

# PORT=3000
# POSTGRES_PASSWORD=ranobe
# WORKER_CONCURRENCY=2
# TZ=Europe/Kyiv

# Only for running outside Docker (pnpm dev):
# DATABASE_URL=postgres://ranobe:ranobe@localhost:5432/ranobe
