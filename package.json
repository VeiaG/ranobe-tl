{
  "name": "ranobe-tl",
  "private": true,
  "version": "0.2.0",
  "description": "Self-hosted web app for translating web novels chapter by chapter with an LLM and a growing glossary",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VeiaG/ranobe-tl.git"
  },
  "engines": {
    "node": ">=22.15"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @ranobe-tl/web dev",
    "dev:worker": "pnpm --filter @ranobe-tl/web dev:worker",
    "build": "pnpm --filter @ranobe-tl/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
